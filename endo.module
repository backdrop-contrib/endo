<?php
/**
 * @file
 * Endo - Enhanced Number Display Options.
 */

/**
 * Implements hook_field_formatter_info_alter().
 */
function endo_field_formatter_info_alter(&$info) {
  // Take ownership of core formatters.
  $info['number_integer']['module'] = 'endo';
  $info['number_integer']['settings'] += array(
    'zero_display' => '',
    'neg_paren' => 0,
  );

  $info['number_decimal']['module'] = 'endo';
  $info['number_decimal']['settings'] += array(
    'trim_leading' => 0,
    'trim_trailing' => 0,
    'trim_decimal' => TRUE,
    'min_scale' => 0,
    'zero_display' => '',
    'neg_paren' => 0,
  );

  // Allow core number formatters (now enhanced by Endo) to be used on Computed Field values.
  if (isset($info['number_integer']['field types']) && !in_array('computed', $info['number_integer']['field types'], TRUE)) {
    $info['number_integer']['field types'][] = 'computed';
    $info['number_integer']['label'] = t('Integer');
  }
  if (isset($info['number_decimal']['field types']) && !in_array('computed', $info['number_decimal']['field types'], TRUE)) {
    $info['number_decimal']['field types'][] = 'computed';
    $info['number_decimal']['label'] = t('Decimal');
  }
  
}

/**
 * Implements hook_field_formatter_settings_summary().
 */
function endo_field_formatter_settings_summary($field, $instance, $view_mode) {
  $display = $instance['display'][$view_mode];
  $settings = $display['settings'];

  $summary = array();

  if ($display['type'] == 'number_decimal') {
    $sample_p = _endo_render_decimal(4321.1234567890, $settings, $instance);
    $sample_n = _endo_render_decimal(-4321.1234567890, $settings, $instance);
    $sample_z = _endo_render_decimal(0, $settings, $instance);
    $summary[] = "$sample_p \u{3000}neg: $sample_n \u{3000}zero: $sample_z"; // Wide space.

    $max = isset($settings['scale']) ? $settings['scale'] : 0;
    $min = isset($settings['min_scale']) ? $settings['min_scale'] : 0;
    $summary[] = t('Decimal places (max/min) = @max / @min', array('@max' => $max, '@min' => $min));

    if (!empty($settings['trim_trailing'])) {
      $summary[] = t('Trailing zeros are suppressed');
    }
    if (!empty($settings['trim_leading'])) {
      $summary[] = t('Leading zero is suppressed');
    }
    // Fix: was "=" (assignment). Keep behavior as intended.
    if ((int) $min == 0 && !empty($settings['trim_decimal'])) {
      $summary[] = t('Trailing decimal is suppressed (integer format)');
    }
  }

  if ($display['type'] == 'number_integer') {
    $sample_p = _endo_render_integer(4321.1234567890, $settings, $instance);
    $sample_n = _endo_render_integer(-4321.1234567890, $settings, $instance);
    $sample_z = _endo_render_integer(0, $settings, $instance);
    $summary[] = "$sample_p \u{3000}neg: $sample_n \u{3000}zero: $sample_z"; // Wide space.
  }

  return implode('<br />', $summary);
}

/**
 * The _endo_render_* functions are where the magic happens...
 */
function _endo_render_integer($input, $settings, $instance) {
  // Normalize missing keys (avoids notices on older displays).
  $settings += array(
    'scale' => 0,
    'decimal_separator' => '.',
    'thousand_separator' => '',
    'zero_display' => '',
    'neg_paren' => 0,
    'prefix_suffix' => 0,
  );

  $output = number_format($input, (int) $settings['scale'], $settings['decimal_separator'], $settings['thousand_separator']);

  if ($settings['zero_display'] !== '' && $input == 0) {
    // Keep as-is (no guard). Sanitize similarly to prefix/suffix.
    $output = field_filter_xss($settings['zero_display']);
  }

  $needs_paren = (!empty($settings['neg_paren']) && $input < 0);
  if ($needs_paren) {
    $output = ltrim($output, '-');
  }

  if (!empty($settings['prefix_suffix'])) {
    $prefixes = isset($instance['settings']['prefix']) ? array_map('field_filter_xss', explode('|', $instance['settings']['prefix'])) : array('');
    $suffixes = isset($instance['settings']['suffix']) ? array_map('field_filter_xss', explode('|', $instance['settings']['suffix'])) : array('');
    $prefix = (count($prefixes) > 1) ? format_plural($input, $prefixes[0], $prefixes[1]) : $prefixes[0];
    $suffix = (count($suffixes) > 1) ? format_plural($input, $suffixes[0], $suffixes[1]) : $suffixes[0];
    $output = $prefix . $output . $suffix;
  }

  // Wrap *after* prefix/suffix so they are included in parentheses.
  if ($needs_paren) {
    $output = '(' . $output . ')';
  }

  return $output;
}

function _endo_render_decimal($input, $settings, $instance) {
  // Normalize missing keys (avoids notices on older displays).
  $settings += array(
    'scale' => 2,
    'min_scale' => 0,
    'decimal_separator' => '.',
    'thousand_separator' => '',
    'trim_leading' => 0,
    'trim_trailing' => 0,
    'trim_decimal' => TRUE,
    'zero_display' => '',
    'neg_paren' => 0,
    'prefix_suffix' => 0,
  );

  $point = $settings['decimal_separator'];

  $output = number_format($input, (int) $settings['scale'], $settings['decimal_separator'], $settings['thousand_separator']);

  if ($settings['zero_display'] !== '' && $input == 0) {
    // Keep as-is (no guard). Sanitize similarly to prefix/suffix.
    $output = field_filter_xss($settings['zero_display']);
  }
  else {
    if (!empty($settings['trim_leading'])) {
      $output = ltrim($output, '0');
    }

    if (!empty($settings['trim_trailing'])) {
      $output = rtrim($output, '0');

      // Only pad to min_scale if there's actually a decimal separator present.
      $pos = strrpos($output, $point);
      if ($pos !== FALSE) {
        while ((strlen($output) - $pos) <= (int) $settings['min_scale']) {
          $output .= '0';
        }
      }
      elseif ((int) $settings['min_scale'] > 0) {
        $output .= $point . str_repeat('0', (int) $settings['min_scale']);
      }
    }

    if (!empty($settings['trim_decimal'])) {
      $output = rtrim($output, $point);
    }
  }

  $needs_paren = (!empty($settings['neg_paren']) && $input < 0);
  if ($needs_paren) {
    $output = ltrim($output, '-');
  }

  if (!empty($settings['prefix_suffix'])) {
    $prefixes = isset($instance['settings']['prefix']) ? array_map('field_filter_xss', explode('|', $instance['settings']['prefix'])) : array('');
    $suffixes = isset($instance['settings']['suffix']) ? array_map('field_filter_xss', explode('|', $instance['settings']['suffix'])) : array('');
    $prefix = (count($prefixes) > 1) ? format_plural($input, $prefixes[0], $prefixes[1]) : $prefixes[0];
    $suffix = (count($suffixes) > 1) ? format_plural($input, $suffixes[0], $suffixes[1]) : $suffixes[0];
    $output = $prefix . $output . $suffix;
  }

  // Wrap *after* prefix/suffix so they are included in parentheses.
  if ($needs_paren) {
    $output = '(' . $output . ')';
  }

  return $output;
}

/**
 * Implements hook_menu().
 */
function endo_menu() {
  return array(
    'admin/config/system/endo' => array(
      'title' => t('Enhanced Number Display'),
      'description' => t('Configure Enhanced Number Display.'),
      'page callback' => 'backdrop_get_form',
      'page arguments' => array('endo_configuration_form'),
      'access arguments' => array('administer endo'),
      'file' => 'endo.admin.inc',
    ),
  );
}

/**
 * Implements hook_permission().
 */
function endo_permission() {
  return array(
    'administer endo' => array(
      'title' => t('Administer Enhanced Number Display'),
    ),
  );
}
/**
 * Implements hook_field_formatter_view().
 */
function endo_field_formatter_view($entity_type, $entity, $field, $instance, $langcode, $items, $display) {
  $element = array();
  $settings = $display['settings'];

  switch ($display['type']) {
    case 'number_integer':
      foreach ($items as $delta => $item) {
        $element[$delta] = array('#markup' => _endo_render_integer($item['value'], $settings, $instance));
      }
      break;

    case 'number_decimal':
      foreach ($items as $delta => $item) {
        $element[$delta] = array('#markup' => _endo_render_decimal($item['value'], $settings, $instance));
      }
      break;

    case 'number_unformatted':
      foreach ($items as $delta => $item) {
        $element[$delta] = array('#markup' => $item['value']);
      }
      break;      
  }
  return $element;
}
    
/**
 * Implements hook_field_formatter_settings_form().
 */
function endo_field_formatter_settings_form($field, $instance, $view_mode, $form, &$form_state) {
  $display = $instance['display'][$view_mode];
  $settings = $display['settings'];
  $element = array();

  $element['prefix_suffix'] = array(
    '#type' => 'checkbox',
    '#title' => t('Display prefix and suffix.'),
    '#default_value' => $settings['prefix_suffix'],
  );
  $element['neg_paren'] = array(
    '#type' => 'checkbox',
    '#title' => t('Use parentheses for negative value; e.g: output "-32.21" as "(32.21)"'),
    '#default_value' => $settings['neg_paren'],
  );
  $element['zero_display'] = array(
    '#type' => 'textfield',
    '#title' => t('Text to display for Zero value.'),
    '#default_value' => $settings['zero_display'],
    '#description' => t('Enter text to override the output of zero.'),
  );

  $element['min_width'] = array(
    '#type' => 'textfield',
    '#title' => t('Minimum field width.'),
    '#default_value' => $settings['min_width'],
    '#description' => t('Smaller values will be left-padded with leading zeros.'),
  );

  if ($display['type'] == 'number_decimal' || $display['type'] == 'number_integer') {
    
    $sep_options = array(
      ''  => t('<none>'),
      '.' => t('Period'),
      ',' => t('Comma'),
      ' ' => t('Space'),
    );
    $element['thousand_separator'] = array(
      '#type' => 'select',
      '#title' => t('Thousand marker'),
      '#options' => $sep_options,
      '#default_value' => $settings['thousand_separator'],
    );

    if ($display['type'] == 'number_decimal') {
      $element['decimal_separator'] = array(
        '#type' => 'select',
        '#title' => t('Decimal marker'),
        '#options' => array('.' => t('Period'), ',' => t('Comma')),
        '#default_value' => $settings['decimal_separator'],
      );
	  $element['scale'] = array(
        '#type' => 'select',
        '#title' => t('Max. decimal places'),
        '#options' => backdrop_map_assoc(range(0, 10)),
        '#default_value' => $settings['scale'],
        '#description' => t('The maximum number of digits to the right of the decimal.'),
      );	
      $element['min_scale'] = array(
        '#type' => 'select',
        '#title' => t('Min. decimal places'),
        '#options' => backdrop_map_assoc(range(0, 10)),
        '#default_value' => $settings['min_scale'],
        '#description' => t('The minimum number of digits to the right of the decimal, even if they are zeros.'),
      );	
      $element['trim_trailing'] = array(
        '#type' => 'checkbox',
        '#title' => t('Suppress trailing zeros after decimal.'),
        '#default_value' => $settings['trim_trailing'],
        '#description' => t('Zeros will be trimmed off, only down to the Min. decimal places set above.'),
      );
      $element['trim_leading'] = array(
        '#type' => 'checkbox',
        '#title' => t('Suppress leading zero before decimal; e.g: output "0.12" as ".12"'),
        '#default_value' => $settings['trim_leading'],
      );
      $element['trim_decimal'] = array(
        '#type' => 'checkbox',
        '#title' => t('Suppress decimal point for integer value; e.g: output "23." as "23"'),
        '#default_value' => $settings['trim_decimal'],
        '#description' => t('This only takes effect if Min. decimal places (above) is set to zero.'),
      );	
    }
  }
  return $element;
}


